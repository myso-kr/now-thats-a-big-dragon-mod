{
  "//": "Every language this mod can add to the game, ordered by Steam share.",
  "//how": [
    "The game ships en/fr/de/pt/tr and picks one from the system locale itself.",
    "Anything else is added to the game's own language list, so it appears in",
    "the settings screen as one more flag - English stays English.",
    "",
    "'matches' are the system-locale prefixes that select this language, and a",
    "longer prefix wins, so zh-Hant beats zh for zh-Hant-TW.",
    "'steamShare' is that language's share of the Steam Hardware Survey",
    "(August 2026). It is the translation priority, not a promise: a language",
    "listed here is only applied once locale/i18n.<code>.json exists.",
    "'fonts' name the woff2 files under locale/fonts/ that replace each game",
    "font, with the pixel-grid numbers that keep them looking like the original.",
    "An empty list means no pixel font covers the script and the system one draws it.",
    "'status' is how much trust the translation has earned: 'draft' means a machine draft nobody has reviewed, 'reviewed' means a speaker has been through it."
  ],
  "gameSupports": [
    "en",
    "fr",
    "de",
    "pt",
    "tr"
  ],
